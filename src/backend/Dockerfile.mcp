# MCP Server - runs as persistent service (SSE transport)
#
# Base image matches the backend Dockerfile and CI (python 3.10) so the MCP
# server cannot drift into a runtime the rest of the stack is not tested on.
FROM python:3.10-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source. `repositories/` is NOT optional: mcp_server.py does
# `from repositories import SqlTaskRepository`, and `user_stub.py` is reached
# transitively through models.py to register the `user` FK target.
COPY mcp_server.py .
COPY models.py .
COPY database.py .
COPY user_stub.py .
COPY repositories/ ./repositories/

# Run MCP server on SSE
EXPOSE 8001
CMD ["python", "mcp_server.py"]
