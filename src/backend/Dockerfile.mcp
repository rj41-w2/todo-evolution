# MCP Server - runs as persistent service (SSE transport)
FROM python:3.12-slim

WORKDIR /app

# Install dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY mcp_server.py .
COPY models.py .
COPY database.py .

# Run MCP server on SSE
EXPOSE 8001
CMD ["python", "mcp_server.py"]